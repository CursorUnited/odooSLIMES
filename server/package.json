{
  "name": "server",
  "version": "1.0.0",
  "description": "Brightloop subscription management API",
  "main": "src/server.js",
  "scripts": {
    "test": "vitest run",
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed": "node prisma/seed.js",
    "db:seed:bulk": "node prisma/seed-bulk.js",
    "db:studio": "prisma studio",
    "db:test:prepare": "node scripts/test-db.js",
    "perf": "node scripts/perf.js"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "engines": {
    "node": ">=24"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
